  "aggregate_surface_disposition": {
    "behaviour": "preserve",
    "interface_disposition": "replace_with_granular_commands",
    "replacement_state": "remove_at_breaking_cutover",
    "rationale": "Each source discriminator selects a distinct request shape or semantic operation; D8 prohibits retaining the aggregate public command."
  },
  "body_source_dispositions": {
    "brain_create.request.content.source": {
      "file": {
        "behaviour": "remove",
        "replacement": "inline_or_stage",
        "rationale": "Caller-owned file paths cross a locality and trust boundary and cannot remain a portable command input."
      },
      "inline": {
        "behaviour": "preserve",
        "disposition": "typed_content_input"
      },
      "stage": {
        "behaviour": "preserve",
        "disposition": "typed_content_input"
      }
    },
    "brain_edit.request.mutation.content.source": {
      "file": {
        "behaviour": "remove",
        "replacement": "inline_or_stage",
        "rationale": "Caller-owned file paths cross a locality and trust boundary and cannot remain a portable command input."
      },
      "inline": {
        "behaviour": "preserve",
        "disposition": "typed_content_input"
      },
      "stage": {
        "behaviour": "preserve",
        "disposition": "typed_content_input"
      }
    }
  },
