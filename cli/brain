#!/usr/bin/env bash
set -euo pipefail

BRAIN_CLI_VERSION="3.1.5"
BRAIN_INSTALL_REF="v0.62.15"

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
SELF_PATH="$SELF_DIR/$(basename -- "$0")"

if [ -n "${BRAIN_CLI_BUNDLE:-}" ]; then
    DISTRIBUTION_ROOT="$BRAIN_CLI_BUNDLE"
elif [ -f "$SELF_DIR/_local_cli/main.py" ] && [ -f "$SELF_DIR/../src/brain-core/VERSION" ]; then
    DISTRIBUTION_ROOT="$(CDPATH= cd -- "$SELF_DIR/.." && pwd -P)"
else
    DISTRIBUTION_ROOT="$SELF_DIR/../lib/brain-cli/$BRAIN_CLI_VERSION"
fi

if [ ! -f "$DISTRIBUTION_ROOT/cli/_local_cli/main.py" ] || [ ! -f "$DISTRIBUTION_ROOT/src/brain-core/VERSION" ]; then
    printf 'brain: CLI distribution %s is missing or incomplete\n' "$DISTRIBUTION_ROOT" >&2
    exit 4
fi

PYTHON=""
for candidate in python3.12 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 12))' >/dev/null 2>&1; then
        PYTHON="$(command -v "$candidate")"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    printf 'brain: Python 3.12 or newer is required\n' >&2
    exit 4
fi

export BRAIN_CLI_BINARY="$SELF_PATH"
export BRAIN_CLI_DISTRIBUTION_ROOT="$DISTRIBUTION_ROOT"
export PYTHONPATH="$DISTRIBUTION_ROOT/cli:$DISTRIBUTION_ROOT/src/brain-core/scripts${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m _local_cli.main "$@"
