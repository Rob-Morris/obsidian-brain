#!/usr/bin/env bash
#
# Pre-commit hook. Rejects main and a detached HEAD outside rebase, then
# checks the staged snapshot under an explicit policy and the matching canary
# receipt. Development uses .canaries/pre-commit-development.md and
# .canary--pre-commit. promotion/* uses .canaries/pre-promotion.md and
# .canary--pre-promotion. The receipt grammar lives in canary_receipt.py.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [[ -z "$branch" ]]; then
  # git commit during an interactive rebase runs with a detached HEAD.
  head_name="$(git rev-parse --git-path rebase-merge/head-name 2>/dev/null || true)"
  if [[ ! -f "$head_name" ]]; then
    head_name="$(git rev-parse --git-path rebase-apply/head-name 2>/dev/null || true)"
  fi
  if [[ -f "$head_name" ]]; then
    branch="$(sed 's|^refs/heads/||' "$head_name")"
  fi
fi
if [[ -z "$branch" ]]; then
  echo "pre-commit: detached HEAD is not a development branch"
  exit 1
fi
if [[ "$branch" == "main" ]]; then
  echo "pre-commit: ordinary commits on main are rejected; promote a candidate from dev"
  exit 1
fi
policy="development"
canary_name="pre-commit-development.md"
if [[ "$branch" == promotion/* ]]; then
  policy="promotion"
  canary_name="pre-promotion.md"
fi
if [[ "${1:-}" == "--print-policy" ]]; then
  printf '%s\n' "$policy"
  exit 0
fi

# Validate facts against the exact snapshot about to be committed. These
# predicates do not belong in the self-reported canary log. The hook never
# rewrites tracked files or stages fixes; release preparation owns mechanics.
PROJECT_PYTHON="$REPO_ROOT/.venv/bin/python"
if [[ ! -x "$PROJECT_PYTHON" ]]; then
  echo "pre-commit: $PROJECT_PYTHON not found — run 'make install' first"
  exit 1
fi
if ! git diff --quiet -- \
  .githooks/pre-commit \
  src/scripts/_repository_contracts \
  src/scripts/_staged_contract_runner.py \
  src/scripts/check_repository_contracts.py; then
  echo "pre-commit: staged-validator bootstrap differs from the working tree"
  echo "Stage the hook and staged-contract runner together before committing."
  exit 1
fi
"$PROJECT_PYTHON" "$REPO_ROOT/src/scripts/check_repository_contracts.py" --staged --policy "$policy"

CANARY_DEF="$REPO_ROOT/.canaries/$canary_name"
CANARY_LOG="$REPO_ROOT/.canary--pre-commit"
if [[ "$policy" == "promotion" ]]; then
  CANARY_LOG="$REPO_ROOT/.canary--pre-promotion"
fi
if [[ ! -f "$CANARY_DEF" ]]; then
  echo "pre-commit: $CANARY_DEF not found — skipping canary check"
  exit 0
fi
"$PROJECT_PYTHON" "$REPO_ROOT/src/scripts/canary_receipt.py" \
  --brief "$CANARY_DEF" \
  --receipt "$CANARY_LOG" \
  --on-empty skip

# Clean up — remove canary log so it can't go stale
rm -f "$CANARY_LOG"

# Dispatch to local pre-commit hook if one exists
LOCAL_HOOK="$REPO_ROOT/.git/hooks/pre-commit"
if [[ -x "$LOCAL_HOOK" ]]; then
  exec "$LOCAL_HOOK" "$@"
fi
