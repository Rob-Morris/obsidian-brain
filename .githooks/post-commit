#!/usr/bin/env bash
#
# Offline reminder only: external CI must never hold up a local commit.

COMMIT=$(git rev-parse HEAD)
printf '\npost-commit: committed %s; CI has not been verified by this hook.\n' "$COMMIT" >&2
printf '%s\n' 'After an authorised push, run src/scripts/check_ci.py for that exact SHA, repository and branch.' >&2
printf '%s\n' 'See docs/standards/agent-workflow.md. Do not propagate until required CI passes.' >&2

# Resolve the extension through Git so linked worktrees use the correct git-dir.
LOCAL_HOOK="$(git rev-parse --git-common-dir)/hooks/post-commit"

if [[ -x "$LOCAL_HOOK" && ! "$LOCAL_HOOK" -ef "$0" ]]; then
  "$LOCAL_HOOK" "$@" || printf '%s\n' 'post-commit: local extension failed; the commit already exists.' >&2
fi
exit 0
